/**
 * Writes the phase 2.1 ("v0.2.1") seven-key chart fixture the parity test compares against.
 *
 * The fixture must be produced by the **original** generator, so this runs inside a checkout of the
 * `v0.2.1` tag. The procedure that works in this repository (no extra tooling needed, and it uses the
 * repo's own vitest/TypeScript toolchain):
 *
 * ```sh
 * git archive v0.2.1 frontend | tar -x -C /tmp/gv021
 * mkdir -p /tmp/gv021/frontend/scripts
 * cp frontend/tests/helpers/analysis-fixture.ts /tmp/gv021/frontend/tests/helpers/
 * cp frontend/scripts/emit-baseline-fixture.mts /tmp/gv021/frontend/tests/emit-baseline.test.ts
 * ln -s "$PWD/node_modules" /tmp/gv021/frontend/node_modules
 * (cd /tmp/gv021/frontend && "$OLDPWD"/node_modules/.bin/vitest run tests/emit-baseline.test.ts)
 * ```
 *
 * The output path comes from `BASELINE_FIXTURE_OUT`, defaulting to the repository's fixture path. The
 * fixture is a frozen artifact: the test only *reads* it, so the parity assertion keeps working after
 * the current generator changes again.
 */

import { writeFileSync } from 'node:fs';
import { it } from 'vitest';
import { generateChart } from '../src/chart/ChartGenerator';
import { FIXTURE_SEED, FIXTURE_SONG, fixtureAnalysis } from '../tests/helpers/analysis-fixture';

const OUT_PATH =
  process.env['BASELINE_FIXTURE_OUT'] ?? '/home/heaxia/App/www/rythmgames/frontend/tests/fixtures/hard-v0.2.1.json';

it('writes the v0.2.1 golden seven-key chart', () => {
  const generated = generateChart(fixtureAnalysis(), { ...FIXTURE_SONG, seed: FIXTURE_SEED });
  const payload = {
    note: 'Generated by the v0.2.1 (phase 2.1) generator. Do not edit by hand.',
    seed: FIXTURE_SEED,
    song: FIXTURE_SONG,
    generator: generated.chart.generator,
    bpm: generated.chart.bpm,
    difficulty: generated.chart.difficulty,
    notes: generated.chart.notes,
    stats: generated.stats,
  };
  writeFileSync(OUT_PATH, `${JSON.stringify(payload, null, 2)}\n`);
  console.log(`wrote ${generated.chart.notes.length} notes to ${OUT_PATH}`);
});
